{% extends 'base.html.twig' %}

{% block title %}Transmission index{% endblock %}

{% block body %}
    <h1>Transmission index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for transmission in transmissions %}
            <tr>
                <td>{{ transmission.id }}</td>
                <td>{{ transmission.name }}</td>
                <td>
                    <a href="{{ path('app_transmission_show', {'id': transmission.id}) }}">show</a>
                    <a href="{{ path('app_transmission_edit', {'id': transmission.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_transmission_new') }}">Create new</a>
{% endblock %}
