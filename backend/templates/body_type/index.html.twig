{% extends 'base.html.twig' %}

{% block title %}BodyType index{% endblock %}

{% block body %}
    <h1>BodyType index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for body_type in body_types %}
            <tr>
                <td>{{ body_type.id }}</td>
                <td>{{ body_type.name }}</td>
                <td>
                    <a href="{{ path('app_body_type_show', {'id': body_type.id}) }}">show</a>
                    <a href="{{ path('app_body_type_edit', {'id': body_type.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_body_type_new') }}">Create new</a>
{% endblock %}
