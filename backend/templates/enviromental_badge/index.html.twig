{% extends 'base.html.twig' %}

{% block title %}EnviromentalBadge index{% endblock %}

{% block body %}
    <h1>EnviromentalBadge index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Image</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for enviromental_badge in enviromental_badges %}
            <tr>
                <td>{{ enviromental_badge.id }}</td>
                <td>{{ enviromental_badge.name }}</td>
                <td><img src="{{ asset('images/enviromentalBadges/' ~ enviromental_badge.image) }}" alt="enviromental badge image" class="enviromental-badge-image" width="40"></td>
                <td>
                    <a href="{{ path('app_enviromental_badge_show', {'id': enviromental_badge.id}) }}">show</a>
                    <a href="{{ path('app_enviromental_badge_edit', {'id': enviromental_badge.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_enviromental_badge_new') }}">Create new</a>
{% endblock %}
