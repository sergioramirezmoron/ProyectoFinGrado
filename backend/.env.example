# =============================================================
#  VARIABLES DE ENTORNO DEL BACKEND — solo para desarrollo local
#  En Docker estas variables las inyecta docker-compose desde
#  el .env de la raíz del proyecto. No es necesario tocar este
#  fichero para el despliegue con Docker.
# =============================================================

# Entorno de ejecución: dev (desarrollo) | prod (producción)
APP_ENV=dev

# Cadena aleatoria de 32+ caracteres usada para firmar tokens CSRF y cookies.
# Genera una con: openssl rand -hex 32
APP_SECRET=cambia_esto_por_una_cadena_aleatoria_larga

# Cadena de conexión a la base de datos MySQL.
# Formato: mysql://usuario:contraseña@host:puerto/nombre_bd?serverVersion=8.0.32&charset=utf8mb4
DATABASE_URL="mysql://usuario:contraseña@127.0.0.1:3306/luxury_cars?serverVersion=8.0.32&charset=utf8mb4"

# Contraseña con la que se cifra la clave privada JWT.
# Debe coincidir con la usada al generar las claves (lexik:jwt:generate-keypair).
JWT_PASSPHRASE=cambia_esto_por_una_clave_segura

# Rutas a las claves JWT (no cambiar si usaste lexik:jwt:generate-keypair)
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem

# Orígenes permitidos para las peticiones CORS (expresión regular).
# Desarrollo local: ^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$
# Producción:       ^https://tudominio\.com$
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# URI base para generar URLs en contextos no-HTTP (comandos de consola). Opcional.
DEFAULT_URI=http://localhost
