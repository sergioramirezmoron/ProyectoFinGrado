# =============================================================
#  .env.local del backend — copia este fichero a .env.local
#  y ajusta los valores. Solo incluye las variables que difieren
#  del .env base; el resto ya tiene valores correctos por defecto.
# =============================================================

# Entorno de ejecución: dev (desarrollo) | prod (producción)
APP_ENV=dev

# Cadena aleatoria de 32+ caracteres usada para firmar tokens CSRF y cookies.
# Genera una con: openssl rand -hex 32
APP_SECRET=cambia_esto_por_una_cadena_aleatoria_larga

# Cadena de conexión a la base de datos MySQL.
# Formato: mysql://usuario:contraseña@host:puerto/nombre_bd?serverVersion=8.0.32&charset=utf8mb4
DATABASE_URL="mysql://root:@127.0.0.1:3306/automocion?serverVersion=8.0.32&charset=utf8mb4"

# Contraseña con la que se cifra la clave privada JWT.
# Debe coincidir con la usada al generar las claves (lexik:jwt:generate-keypair).
JWT_PASSPHRASE=mi_secreto_tfg

# Orígenes permitidos para consumir la API desde navegador.
# Añade aquí el dominio público del frontend cuando despliegues en otro entorno.
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$|^https://luxurycars\.up\.railway\.app$'
