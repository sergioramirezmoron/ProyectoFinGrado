# =============================================================
#  CONFIGURACIÓN DE DESPLIEGUE — copia este archivo a .env
#  y rellena los valores antes de ejecutar docker-compose up
# =============================================================

# URL pública donde estará la aplicación (sin barra final)
# - Local:  http://localhost
# - VPS:    http://TU_IP  o  https://tudominio.com
SERVER_URL=http://localhost

# Secreto de la aplicación Symfony (cadena aleatoria de 32+ caracteres)
APP_SECRET=cambia_esto_por_una_cadena_aleatoria_larga

# Contraseña para firmar los tokens JWT
JWT_PASSPHRASE=cambia_esto_por_una_clave_segura

# Contraseña de la base de datos
DB_PASSWORD=cambia_esto_por_una_contraseña_segura

# Orígenes permitidos para CORS (expresión regular)
# - Local:  ^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$
# - VPS:    ^https?://TU_IP(:[0-9]+)?$
# - Dominio: ^https://tudominio\.com$
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$
